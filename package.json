{
  "name": "dsh-bill-visualization",
  "version": "0.2.0",
  "description": "Local token & cost (bill) visualization dashboard for DeepSeek Harness: budget bar, request log, provider/model/workspace filters, cache savings, official price import (0.2.1-rc.2 / 0.1.5-rc.2 / 0.1.3-alpha.2)",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "web",
    "cordis.patch.yml",
    "README.md",
    "COMPATIBILITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "pack:local": "npm pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.1.3-alpha.2": "compatible"
      }
    }
  },
  "license": "MIT"
}
